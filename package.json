{
  "name": "craftlayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "10.23.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "docs:check": "python3 scripts/check-docs.py",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
