{
  "name": "craftlayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "10.23.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:server && tsc -p tsconfig.tests.json && pnpm --filter @craftlayer/web typecheck",
    "lint": "biome check . --error-on-warnings && node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "docs:check": "python3 scripts/check-docs.py",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "node scripts/test-database.mjs",
    "build:server": "pnpm -r --filter '!@craftlayer/web' run build",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/main.ts",
    "dev:worker": "node --env-file=.worker-secrets/host.env --import tsx apps/worker/src/main.ts",
    "dev:web": "pnpm --filter @craftlayer/web dev",
    "cli": "node --env-file-if-exists=.env --import tsx apps/cli/src/main.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "compose:check": "docker compose config --quiet",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:offline": "node scripts/test-offline.mjs",
    "check:stack": "node --env-file-if-exists=.env scripts/check-stack.mjs",
    "test:identity-ui": "node scripts/test-identity-ui.mjs",
    "setup:providers": "node scripts/setup-providers.mjs",
    "test:provider-stack": "node scripts/test-provider-stack.mjs",
    "setup:worker": "node scripts/setup-worker.mjs",
    "test:runtime-stack": "node scripts/test-runtime-stack.mjs",
    "test:preflight": "vitest run tests/unit/minecraft-preflight.test.ts",
    "test:preflight:recovery": "vitest run tests/unit/minecraft-preservation.test.ts",
    "test:server-ui": "node scripts/test-server-ui.mjs",
    "test:node:broker": "pnpm build:server && node scripts/test-node-broker.mjs",
    "minecraft:identity:prepare": "node --import tsx scripts/minecraft/identity-fixture.ts prepare",
    "minecraft:identity:verify": "node --import tsx scripts/minecraft/identity-fixture.ts verify",
    "prototype:up": "node scripts/prototype.mjs up",
    "prototype:down": "node scripts/prototype.mjs down",
    "prototype:refresh": "node scripts/prototype.mjs refresh",
    "prototype:node:renew": "node scripts/prototype.mjs node-renew",
    "node:pki:fixture": "node --import tsx scripts/minecraft/node-fixtures.ts",
    "node:keygen": "node apps/minecraft-node/dist/main.js keygen",
    "node:run": "node apps/minecraft-node/dist/main.js run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "bullmq": "6.5.3",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
