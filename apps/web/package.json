{
  "name": "@craftlayer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@craftlayer/contracts": "workspace:*",
    "@craftlayer/sdk": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
