# Run pnpm setup:local to create .env with random values; never reuse placeholders.
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
RUNTIME_PASSWORD=
REDIS_PASSWORD=
CRAFTLAYER_HTTP_PORT=3000
# Host development URLs (only with infra/compose/development.yml).
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
IDENTITY_PASSWORD=
AUTH_DATABASE_URL=
CRAFTLAYER_BOOTSTRAP_TOKEN=
CRAFTLAYER_RECOVERY_TOKEN=
CRAFTLAYER_CSRF_SECRET=
CRAFTLAYER_PUBLIC_URL=http://127.0.0.1:3000
# Set true for any deployment reachable away from this machine (for example over Tailscale).
CRAFTLAYER_REQUIRE_MFA=false

# Optional protected captured inventory; keep actual player data outside Git.
# CRAFTLAYER_MINECRAFT_INVENTORY_FILE=/absolute/protected/inventory.json
